# Supabase (https://supabase.com → Project Settings → API keys). Copy to .env.local.
# Never commit real values.

# Public: safe in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET: server only, records official scores. Never prefix it with NEXT_PUBLIC_,
# never share it. (A classic "service_role" key works too, as SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=
